# Local SQLite persistence; leave unset for default.
ONEJOURNEY_DB=./onejourney.sqlite3
# Live GenAI advisor (Responses API with bounded function calling).
# Copy this file to .env and set a server-side key; never expose it in frontend code.
OPENAI_API_KEY=replace_with_your_own_key
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
